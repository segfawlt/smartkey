# Maintainer: segfawlt <segfawlt@users.noreply.github.com>
pkgname=fcitx5-smartkey
pkgver=0.1.2
pkgrel=1
pkgdesc="Privacy-first on-device PC English autocorrect and backspace learner for Fcitx5 (includes smartkey & smartkeyctl)"
arch=('x86_64' 'aarch64')
url="https://github.com/segfawlt/smartkey"
license=('GPL-3.0-or-later')
depends=('fcitx5>=5.0.20' 'gcc-libs' 'glibc' 'curl')
makedepends=('cargo' 'cmake')
options=('!debug' '!lto')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export PATH="$HOME/.cargo/bin:$PATH"
    export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-stable}
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export PATH="$HOME/.cargo/bin:$PATH"
    export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-stable}
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p smartkey-cli --bin smartkey
    cmake -B build -S adapters/fcitx5-smartkey \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DFCITX_INSTALL_USE_FCITX_SYS_PATHS=ON \
        -DSMARTKEY_CARGO_FLAGS="--frozen"
    cmake --build build -j"$(nproc)"
}

check() {
    cd "$pkgname-$pkgver"
    export PATH="$HOME/.cargo/bin:$PATH"
    export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-stable}
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
    ctest --test-dir build --output-on-failure
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm755 target/release/smartkey "$pkgdir/usr/bin/smartkey"
    ln -s smartkey "$pkgdir/usr/bin/smartkeyctl"
    install -Dm644 crates/smartkey-core/assets/en_lexicon.skdict "$pkgdir/usr/share/smartkey/dicts/en.skdict"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
